# 观页 · 无域名公网 IP 反向代理示例
#
# 最低 Caddy 版本：v2.11.3。
# v2.11.3 是首个包含 certmagic v0.25.3 的 Caddy 发行版；该依赖修复了
# caddyserver/caddy#7399 中 IPv6 Host 方括号导致的 ACME challenge 规范化问题。
# 参考：
#   https://github.com/caddyserver/caddy/issues/7399
#   https://github.com/caddyserver/certmagic/pull/376
#
# 唯一输入：PUBLIC_IP
# - 填 Let's Encrypt 可为本机签发的公开 IP 字面量。
# - 只填 IP，不写协议、端口、路径、证书或私钥。
# - IPv4 和 IPv6 均可；IPv6 不要加方括号。
# - PowerShell 7 示例：$env:PUBLIC_IP = '203.0.113.10'
# - POSIX shell 示例：export PUBLIC_IP='203.0.113.10'
#
# 公网 TCP 80 用于证书验证，TCP 443 用于网页 API；只向本机 8787 代理。
# 默认 SNI 兼容不发送 SNI 的公网 IP 客户端。
{
 admin off
 default_sni {$PUBLIC_IP}
 servers {
  protocols h1 h2
 }
}

{$PUBLIC_IP} {
 tls {
  issuer acme {
   dir https://acme-v02.api.letsencrypt.org/directory
   profile shortlived
   disable_tlsalpn_challenge
  }
 }
 @health path /healthz
 respond @health "ok" 200
 @creative path /api/ai/planning /api/ai/planning/* /api/ai/generation /api/ai/generation/*
 reverse_proxy @creative 127.0.0.1:8787
 @root path /
 redir @root https://pwmpro-a.github.io/guanye-ppt-review/ 302
}
